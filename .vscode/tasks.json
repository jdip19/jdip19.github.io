{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "typescript",
			"tsconfig": "projects/Fig-Plugin/QuicText/tsconfig.json",
			"problemMatcher": [
				"$tsc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "tsc: build - projects/Fig-Plugin/QuicText/tsconfig.json"
		},
		{
			"label": "Install Dependencies",
			"type": "shell",
			"command": "npm install"
		},
		{
			"label": "Build Next.js App",
			"type": "shell",
			"command": "npm run build"
		}
	]
}